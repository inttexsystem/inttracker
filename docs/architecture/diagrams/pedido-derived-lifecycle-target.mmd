    SNOTE(["D7 · concluida NAO vai direto a cancelada<br/>exige antes correcao ou reversao autorizada<br/>finalizada e legado: sem acao e sem writer novo"]):::derived
    S1 --> S2 --> S3
    S3 -->|"pausar"| S4
    S4 -->|"retomar"| S3
    S3 --> SCONC --> S5
    S1 --> SGT
    S2 --> SGT
    S3 --> SGT
    S4 --> SGT
    SGT -->|"sim"| S6
    S5 -.- SNOTE
    SNOTE -.- SGT
  end
